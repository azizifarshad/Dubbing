# ==============================================================================
# Git Ignore Configuration - Dubbing Multi-User Software Product
# ==============================================================================

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build and distribution directories
dist/
dist-installer/
dist-server/
build/
out/
coverage/

# Application binaries, installers and packages
*.exe
!DubbingVidans.exe
*.msi
*.dll
*.pyd
*.so
*.dylib
*.app
*.dmg
*.deb
*.rpm

# Python runtimes, cache, and virtual environments
runtime/
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.spec

# Offline licensing secret keys and generated customer files
*.pem
*.key
owner_private_key.pem
tools/license-generator/keys/owner_private_key.pem
tools/update-signer/keys/update_signer_private_key.pem
!tools/license-generator/keys/owner_public_key.pem
!tools/update-signer/keys/update_signer_public_key.pem
tools/license-generator/build/
tools/license-generator/dist/
tools/license-generator/__pycache__/
*.dblic
*.dbreq
.license_data/

# Environment files and secrets (NEVER commit actual environment variables)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
!.env.example
!app/applet/.env.example

# Large AI and Whisper models (downloaded dynamically or bundled in installer)
models/

# Application updates download and staging directory
updates/
temp/
app/temp/
*.tmp

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE and Editor configuration
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Local scratch and working folders
Sadra/
scratch/
*.log
