{
  "name": "dubbing-vidans",
  "private": true,
  "version": "1.0.1",
  "description": "Professional AI-Powered Video Dubbing and Synchronization Studio",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "node server.ts",
    "update-server": "tsx update-server/src/server.ts",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --target=node18 --outfile=server.cjs --external:vite",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:ci": "tsx tests/syncEngine.test.ts && tsx tests/balancedDubbingSystem.test.ts && tsx tests/overlapAndBulkSpeed.test.ts && tsx tests/autoFixTimeline.test.ts && tsx tests/zeroSilenceAndFlexiblePlacement.test.ts && tsx tests/hormouzJsonExtractor.test.ts && tsx tests/licensingSystem.test.ts && tsx tests/autoUpdateSystem.test.ts",
    "test:integration": "tsx tests/videoBrandingPipeline.test.ts && tsx tests/offlineSystemIntegration.test.ts",
    "test": "npm run test:ci && npm run test:integration"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
