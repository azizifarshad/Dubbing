# ==============================================================================
# Dubbing Update Gateway - Environment Configuration
# ==============================================================================

# Port the update proxy server listens on
PORT=4000

# Target Private GitHub Repository
GITHUB_REPO_OWNER=azizifarshad
GITHUB_REPO_NAME=Dubbing

# ------------------------------------------------------------------------------
# OPTION 1: GitHub App Authentication (RECOMMENDED for Production Multi-User)
# ------------------------------------------------------------------------------
# 1. Register a GitHub App under your organization/account.
# 2. Grant repository permission: "Contents: Read-only".
# 3. Install the GitHub App on the private repository azizifarshad/Dubbing.
# 4. Supply the App ID, Installation ID, and Private Key below:
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
# Or specify path to the private key PEM file:
GITHUB_APP_PRIVATE_KEY_PATH=

# ------------------------------------------------------------------------------
# OPTION 2: Fine-Grained Personal Access Token (Quick / Fallback)
# ------------------------------------------------------------------------------
# Requires 'contents: read' permission on private repository azizifarshad/Dubbing.
# Note: Token is kept exclusively on the server and is never exposed to clients.
GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# Authorization & Security
# ------------------------------------------------------------------------------
# Require client to send valid hardware fingerprint (X-Hardware-Fingerprint) header
REQUIRE_LICENSE_AUTH=false

# Node environment
NODE_ENV=production
